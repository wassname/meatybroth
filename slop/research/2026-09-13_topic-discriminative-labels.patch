+fn discriminative_topic_labels(
+    rows: &[(Vec<u8>, Vec<f32>, String, Vec<u8>)],
+    assignments: &[usize],
+    cluster_count: usize,
+) -> Vec<String> {
+    static STOP: LazyLock<std::collections::HashSet<&'static str>> =
+        LazyLock::new(|| include_str!("data/english-stopwords.txt").lines().collect());
+    let urls = regex::Regex::new(r"(?i)https?://\S+").unwrap();
+    let words = regex::Regex::new(r"(?i)[\p{L}\p{N}][\p{L}\p{N}_-]{2,}").unwrap();
+    let terms: Vec<std::collections::HashSet<String>> = rows
+        .iter()
+        .map(|(_, _, text, _)| {
+            words
+                .find_iter(&urls.replace_all(text, " "))
+                .map(|word| word.as_str().to_lowercase())
+                .filter(|word| {
+                    word.is_ascii()
+                        && word
+                            .chars()
+                            .any(|character| character.is_ascii_alphabetic())
+                        && word.chars().count() <= 32
+                        && !STOP.contains(word.as_str())
+                        && !word.starts_with("http")
+                })
+                .collect()
+        })
+        .collect();
+    let mut global_df = std::collections::HashMap::<String, usize>::new();
+    for document in &terms {
+        for word in document {
+            *global_df.entry(word.clone()).or_default() += 1;
+        }
+    }
+    (0..cluster_count)
+        .map(|cluster| {
+            let cluster_size = assignments
+                .iter()
+                .filter(|value| **value == cluster)
+                .count();
+            let mut support = std::collections::HashMap::<String, usize>::new();
+            let mut authors =
+                std::collections::HashMap::<String, std::collections::HashSet<&[u8]>>::new();
+            for ((_, _, _, author), document) in rows
+                .iter()
+                .zip(&terms)
+                .enumerate()
+                .filter_map(|(index, row)| (assignments[index] == cluster).then_some(row))
+            {
+                for word in document {
+                    *support.entry(word.clone()).or_default() += 1;
+                    authors.entry(word.clone()).or_default().insert(author);
+                }
+            }
+            let minimum_support = 5.max(cluster_size.div_ceil(50));
+            let mut scored: Vec<_> = support
+                .into_iter()
+                .filter(|(word, count)| *count >= minimum_support && authors[word].len() >= 3)
+                .map(|(word, count)| {
+                    let score = count as f64 / cluster_size as f64
+                        * ((rows.len() + 1) as f64 / (global_df[&word] + 1) as f64).ln();
+                    (word, score)
+                })
+                .collect();
+            scored.sort_by(|left, right| {
+                right
+                    .1
+                    .total_cmp(&left.1)
+                    .then_with(|| left.0.cmp(&right.0))
+            });
+            let selected: Vec<_> = scored.into_iter().take(3).map(|(word, _)| word).collect();
+            if selected.len() < 2 {
+                "mixed".into()
+            } else {
+                selected.join(" · ")
+            }
+        })
+        .collect()
+}
